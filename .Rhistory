data(campyDE, package = "surveillance")
tibble(y = diff(campyDE$case),
date = campyDE$date[-1]) |>
ggplot(aes(x = date,
y = y)) +
geom_line() +
theme_minimal(base_size=14) +
labs(x = "Date",
y = "Difference in # reported cases")
a <- vector()
alpha0_trace <- vector()
alpha1_trace <- vector()
y = diff(campyDE$case)
y_t = y[-1]
y_t_minus_1 = y[-NROW(y)]
n_time_points = NROW(y_t)
lpost <- function(x){
alpha0 <- x[1]
alpha1 <- x[2]
a <<- c(a, alpha0)
-(1/2) * sum(log(alpha0 + alpha1 * y_t_minus_1^2)) - (1/2) * sum((alpha0 + alpha1 * y_t_minus_1^2)^(-1) * y_t^2)
}
lpost_grad <- function(x){
alpha0 <- x[1]
alpha1 <- x[2]
grad_alpha_0 <- -(1/2) * sum((alpha0 + alpha1 * y_t_minus_1^2)^(-1)) + (1/2) * sum((alpha0 + alpha1 * y_t_minus_1^2)^(-2) * y_t^2)
grad_alpha_1 <- -(1/2) * sum((alpha0 + alpha1 * y_t_minus_1^2)^(-1) * y_t_minus_1^2) + (1/2) * sum((alpha0 + alpha1 * y_t_minus_1^2)^(-2) * y_t^2 * y_t_minus_1^2)
alpha0_trace <<- c(alpha0_trace, grad_alpha_0)
alpha1_trace <<- c(alpha1_trace, grad_alpha_1)
return(c(grad_alpha_0, grad_alpha_1))
}
opt1 <- optim(par = c(1000, 0.01),
fn = lpost,
gr = lpost_grad,
control = list(fnscale = -1.0,
maxit = 1e4,
trace = 5),
hessian = TRUE,
method = "BFGS")
opt1$par

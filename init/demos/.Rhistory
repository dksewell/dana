ggplot(ndat) + geom_histogram(mapping = aes(x = y, fill = group)) + labs(title = "Normal Outcome")
ggplot(ldat) + geom_histogram(mapping = aes(x = y, fill = group), bins = 40) + labs(title = "Lognormal Outcome (Nontransformed)")
ggplot(ldat) + geom_histogram(mapping = aes(x = log(y), fill = group), bins = 40) + labs(title = "Lognormal Outcome (Transformed)")
# Assign log normal distribution outcomes
y <- exp(rnorm(n = 2*n_per_group, mean = x + rep(c(2, 0), each = n_per_group), sd = 1))  # Exponentiated response!
ldat <- data.frame(group, x, y)
# Compare plots
ggplot(ndat) + geom_histogram(mapping = aes(x = y, fill = group)) + labs(title = "Normal Outcome")
ggplot(ldat) + geom_histogram(mapping = aes(x = y, fill = group), bins = 40) + labs(title = "Lognormal Outcome (Nontransformed)")
ggplot(ldat) + geom_histogram(mapping = aes(x = log(y), fill = group), bins = 40) + labs(title = "Lognormal Outcome (Transformed)")
ggplot(ldat) + geom_histogram(mapping = aes(x = y, fill = group), bins = 40) + labs(title = "Lognormal Outcome (Nontransformed)")
ggplot(ldat) + geom_histogram(mapping = aes(x = log(y), fill = group), bins = 40) + labs(title = "Lognormal Outcome (Transformed)")
